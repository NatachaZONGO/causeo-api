APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Adresse publique de cette API, sans / final (ex. https://api.getcauseo.com).
# Voir DOMAINE.md pour tout ce qui dépend du domaine.
APP_URL=http://localhost
# Dashboard, sans / final : liens des e-mails, retour de la connexion Google, CORS
FRONTEND_URL=http://localhost:4200
# Origines CORS autorisées, séparées par des virgules (par défaut : FRONTEND_URL).
# Pendant un changement de domaine : l'ancienne et la nouvelle adresse du dashboard.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330

# Alertes WhatsApp aux gérants, depuis le numéro Causeo (+226 46 73 11 17, WABA
# « Causeo by Devora »), avec WHATSAPP_TOKEN. L'utilisateur système doit avoir accès
# à ce WABA. Enregistrer le numéro : php artisan whatsapp:register-notify-number --pin=XXXXXX
CAUSEO_NOTIFY_PHONE_NUMBER_ID=
CAUSEO_NOTIFY_WABA_ID=

# Mode Express (bridge Baileys), inutilisé : ses webhooks répondent 404 sauf si
# WHATSAPP_EXPRESS_ENABLED=true et WHATSAPP_BRIDGE_TOKEN est un secret non vide.
WHATSAPP_EXPRESS_ENABLED=false
WHATSAPP_BRIDGE_URL=http://localhost:3001
WHATSAPP_BRIDGE_TOKEN=

# Essai Pro offert à l'inscription : TRIAL_DAYS jours ou TRIAL_UNITS unités (1 unité =
# 1 réponse de l'assistant), selon ce qui arrive en premier. Figé au début de chaque essai.
TRIAL_DAYS=15
TRIAL_UNITS=300

# Pause (en heures) au-delà de laquelle le bot ouvre une nouvelle session de conversation
AI_SESSION_GAP_HOURS=6

# Rythme des réponses WhatsApp (secondes) : regroupement des messages du client
# (attente relancée à chaque message, au plus AI_REPLY_MAX_WAIT_SECONDS après le premier),
# puis délai « en train d'écrire » proportionnel à la longueur de la réponse.
AI_REPLY_DEBOUNCE_SECONDS=8
AI_REPLY_MAX_WAIT_SECONDS=30
AI_REPLY_TYPING_BASE_SECONDS=3
AI_REPLY_TYPING_CHARS_PER_SECOND=40
AI_REPLY_TYPING_JITTER_SECONDS=1.5
AI_REPLY_TYPING_MAX_SECONDS=20

# Coût des réponses (statistiques admin) : taux de conversion des dollars en FCFA.
# Les prix par modèle sont dans config/services.php (anthropic.pricing.models).
AI_COST_USD_TO_XOF=600

# Optionnel : chemin vers un cacert.pem pour les requêtes HTTPS sortantes (dev Windows/WAMP).
# À laisser vide en production Linux.
# CURL_CA_BUNDLE=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP Brevo : port 2525.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Adresse d'un domaine vérifié chez Brevo (SPF, DKIM, DMARC).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Connexion Google. URL de redirection, à déclarer telle quelle dans Google Cloud :
# APP_URL + /auth/google/callback (ex. https://api.getcauseo.com/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Secret de l'app Meta qui reçoit les webhooks WhatsApp (par défaut : FACEBOOK_APP_SECRET)
WHATSAPP_APP_SECRET=

# Paiement manuel des abonnements (XOF). Un moyen sans numéro n'est pas proposé.
PAYMENT_ACCOUNT_NAME=Causeo
PAYMENT_ORANGE_MONEY_NUMBER=
PAYMENT_MOOV_MONEY_NUMBER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage (S3) : Project Settings > Storage > S3 Connection
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=eu-central-1
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_DOCUMENTS_BUCKET=documents
SUPABASE_STORAGE_MEDIA_BUCKET=media
SUPABASE_STORAGE_MEDIA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

VITE_APP_NAME="${APP_NAME}"
