# Réglages de la sauvegarde de la base (deploy/backup.sh), sur le VPS :
#   sudo install -m 600 -o root -g root deploy/backup.env.example /etc/causeo-backup.env
#   sudo nano /etc/causeo-backup.env
# Les identifiants de la base sont lus dans /var/www/causeo-api/.env : rien à recopier ici.

# Clé PUBLIQUE age (« age1… ») : la clé privée reste hors du VPS (voir SAUVEGARDES.md).
AGE_RECIPIENT=

# Bucket privé « causeo-backups » d'un AUTRE projet que la production (projet Supabase
# dédié, Cloudflare R2, Backblaze B2…), avec une clé S3 réservée aux sauvegardes.
# Supabase : Project Settings → Storage → S3 Connection.
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=https://<projet-sauvegardes>.supabase.co/storage/v1/s3
OFFSITE_S3_REGION=eu-central-1
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
OFFSITE_S3_BUCKET=causeo-backups

# Adresses prévenues en cas d'échec, en plus des admins Causeo (séparées par des virgules).
BACKUP_ALERT_EMAILS=

# Facultatif, recommandé : URL de ping d'un service de surveillance (healthchecks.io, gratuit).
# Réussite : GET <url> ; échec : POST <url>/fail. Le service alerte aussi si aucun ping
# n'arrive (cron arrêté, serveur éteint) : régler la période à 1 jour et la tolérance à 2 h.
HEALTHCHECK_URL=

# Version de pg_dump : au moins celle de la base (SHOW server_version).
PG_MAJOR=17

# Conservation (jours) : sur le VPS, et dans le bucket.
RETENTION_DAYS=14
OFFSITE_RETENTION_DAYS=30

# Valeurs par défaut, à ne changer que si l'installation diffère.
BACKUP_DIR=/var/backups/causeo
API_DIR=/var/www/causeo-api
PHP_BIN=/usr/bin/php8.2
