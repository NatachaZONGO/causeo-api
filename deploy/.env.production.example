# Modèle du .env de production sur le VPS : /var/www/causeo-api/.env
# (propriétaire deploy, droits 600). DOMAINE : getcauseo.com en production.
# Ne jamais committer le fichier rempli.
#
# Après toute modification : sudo -u deploy -H bash /var/www/causeo-api/deploy/deploy.sh api
# (config:cache relit ce fichier).

# --- Application ------------------------------------------------------------------------

APP_NAME=Causeo
APP_ENV=production
# !!! Ne jamais changer : elle déchiffre les tokens WhatsApp des businesses
# (pour la changer quand même, mettre l'ancienne dans APP_PREVIOUS_KEYS). Une autre clé les rend illisibles (plus aucun message ne part).
APP_KEY=
# Seulement si la clé a déjà été changée un jour (anciennes clés, séparées par des virgules).
APP_PREVIOUS_KEYS=
APP_DEBUG=false
# Adresse publique de l'API
APP_URL=https://api.DOMAINE
# Dashboard (domaine nu, sans / final) : liens des e-mails, retour de la connexion Google
FRONTEND_URL=https://DOMAINE
# Vide : seul FRONTEND_URL est autorisé. Origines supplémentaires séparées par des virgules.
CORS_ALLOWED_ORIGINS=
# nginx parle directement à php-fpm : la valeur par défaut suffit.
# TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Fichiers storage/logs/laravel-AAAA-MM-JJ.log, gardés 14 jours
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Base de données (Supabase) -----------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
# Ou, à la place des lignes ci-dessus, une URL de connexion :
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Stockage des fichiers (Supabase Storage, S3) ----------------------------------------

SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=eu-central-1
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_DOCUMENTS_BUCKET=documents
SUPABASE_STORAGE_MEDIA_BUCKET=media
SUPABASE_STORAGE_MEDIA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# --- E-mails (Brevo) ---------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Adresse du domaine authentifié chez Brevo (SPF, DKIM, DMARC), par exemple contact@DOMAINE.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Causeo

# --- WhatsApp / Meta ----------------------------------------------------------------------

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Alertes WhatsApp aux gérants (numéro Causeo)
CAUSEO_NOTIFY_PHONE_NUMBER_ID=
CAUSEO_NOTIFY_WABA_ID=

# Mode Express (bridge Baileys) : inutilisé, ses webhooks répondent 404.
WHATSAPP_EXPRESS_ENABLED=false
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=

# --- Connexion Google ---------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# À déclarer à l'identique dans Google Cloud (URI de redirection autorisés)
GOOGLE_REDIRECT_URI=https://api.DOMAINE/auth/google/callback

# --- IA -----------------------------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Transcription des messages vocaux (accepte l'audio OGG/Opus)
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
# Facultative :
OPENAI_API_KEY=
AI_SESSION_GAP_HOURS=6
AI_COST_USD_TO_XOF=600

# Rythme des réponses WhatsApp (secondes) : regroupement des messages du client
# (attente relancée à chaque message, au plus AI_REPLY_MAX_WAIT_SECONDS après le premier),
# puis délai « en train d'écrire » proportionnel à la longueur de la réponse.
AI_REPLY_DEBOUNCE_SECONDS=8
AI_REPLY_MAX_WAIT_SECONDS=30
AI_REPLY_TYPING_BASE_SECONDS=3
AI_REPLY_TYPING_CHARS_PER_SECOND=40
AI_REPLY_TYPING_JITTER_SECONDS=1.5
AI_REPLY_TYPING_MAX_SECONDS=20

# Essai Pro offert à l'inscription : TRIAL_DAYS jours ou TRIAL_UNITS unités (1 unité =
# 1 réponse de l'assistant), selon ce qui arrive en premier. Figé au début de chaque essai.
TRIAL_DAYS=15
TRIAL_UNITS=300

# --- Paiements manuels --------------------------------------------------------------------

PAYMENT_ACCOUNT_NAME=Causeo
PAYMENT_ORANGE_MONEY_NUMBER=
PAYMENT_MOOV_MONEY_NUMBER=

# Worker de file : Supervisor (deploy/supervisor/causeo-worker.conf).
# Planificateur : cron, sudo causeo-scheduler on|off|status (deploy/scheduler.sh).
