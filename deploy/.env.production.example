# Modèle du .env de production sur le VPS : /var/www/causeo-api/.env
# (propriétaire deploy, droits 600). Copier les valeurs depuis Render > causeo-api >
# Environment ; « [VPS] » marque ce qui change par rapport à Render.
# Ne jamais committer le fichier rempli.
#
# Après toute modification : sudo -u deploy -H bash /var/www/causeo-api/deploy/deploy.sh api
# (config:cache relit ce fichier).

# --- Application ------------------------------------------------------------------------

APP_NAME=Causeo
APP_ENV=production
# !!! EXACTEMENT la même valeur que sur Render : elle déchiffre les tokens WhatsApp des
# businesses. Une autre clé les rend illisibles (plus aucun message ne part).
APP_KEY=
# Seulement si la clé a déjà été changée un jour (anciennes clés, séparées par des virgules).
APP_PREVIOUS_KEYS=
APP_DEBUG=false
# [VPS] Adresse publique de l'API
APP_URL=https://api.DOMAINE
# [VPS] Dashboard (domaine nu, sans / final) : liens des e-mails, retour de la connexion Google
FRONTEND_URL=https://DOMAINE
# [VPS] Pendant la transition : ancien et nouveau dashboard. Vider après l'arrêt de Vercel.
CORS_ALLOWED_ORIGINS=https://causeo-dashboard.vercel.app,https://DOMAINE
# [VPS] nginx parle directement à php-fpm : la valeur par défaut suffit.
# TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# [VPS] Fichiers storage/logs/laravel-AAAA-MM-JJ.log, gardés 14 jours
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Base de données (Supabase, partagée avec Render pendant la transition) -------------

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
# Ou, à la place des lignes ci-dessus, si Render utilise une URL de connexion :
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Stockage des fichiers (Supabase Storage, S3) ----------------------------------------

SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=eu-central-1
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_DOCUMENTS_BUCKET=documents
SUPABASE_STORAGE_MEDIA_BUCKET=media
SUPABASE_STORAGE_MEDIA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# --- E-mails (Brevo) ---------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
# 2525 comme sur Render (587 y est bloqué) ; il fonctionne aussi depuis le VPS.
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# [VPS] Garder l'adresse actuelle tant que le domaine n'est pas authentifié chez Brevo,
# puis passer à une adresse du domaine (MIGRATION.md, étape 9).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Causeo

# --- WhatsApp / Meta ----------------------------------------------------------------------

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Alertes WhatsApp aux gérants (numéro Causeo)
CAUSEO_NOTIFY_PHONE_NUMBER_ID=
CAUSEO_NOTIFY_WABA_ID=

# Mode Express (bridge Baileys) : inutilisé, ses webhooks répondent 404.
WHATSAPP_EXPRESS_ENABLED=false
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=

# --- Connexion Google ---------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [VPS] À déclarer à l'identique dans Google Cloud (MIGRATION.md, étape 9)
GOOGLE_REDIRECT_URI=https://api.DOMAINE/auth/google/callback

# --- IA -----------------------------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Seulement si Render en définit une :
OPENAI_API_KEY=
AI_SESSION_GAP_HOURS=6
AI_COST_USD_TO_XOF=600

# Essai Pro offert à l'inscription : TRIAL_DAYS jours ou TRIAL_UNITS unités (1 unité =
# 1 réponse de l'assistant), selon ce qui arrive en premier. Figé au début de chaque essai.
TRIAL_DAYS=15
TRIAL_UNITS=300

# --- Paiements manuels --------------------------------------------------------------------

PAYMENT_ACCOUNT_NAME=Causeo
PAYMENT_ORANGE_MONEY_NUMBER=
PAYMENT_MOOV_MONEY_NUMBER=

# --- Propres à Render (inutiles sur le VPS) -----------------------------------------------
# PORT, PHP_CLI_SERVER_WORKERS : php artisan serve n'est pas utilisé ici.
# RUN_SCHEDULER, RUN_QUEUE_WORKER : lus par docker-entrypoint.sh (Render) seulement ; sur
# le VPS, le worker passe par Supervisor et le planificateur par causeo-scheduler.
